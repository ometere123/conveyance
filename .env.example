# Address of the deployed Conveyance Intelligent Contract.
# Leave unset to browse the app against the bundled fixtures (src/lib/mock-data.ts).
# Set it, and every read and write in src/lib/data-source.ts switches to the live contract.
NEXT_PUBLIC_CONVEYANCE_CONTRACT=

# GenLayer JSON-RPC endpoint and chain. Defaults below are StudioNet.
NEXT_PUBLIC_GENLAYER_ENDPOINT=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN=studionet

# Force the data source regardless of the contract address: "live" or "fixtures".
# Unset means live when a contract address is configured, fixtures otherwise.
NEXT_PUBLIC_CONVEYANCE_DATA=
